# Lokale Entwicklung. In Produktion (Coolify) werden dieselben Variablen als
# Environment-Variablen der Application gesetzt — siehe docs/deployment-coolify.md.
# NODE_ENV und PORT setzt dort bereits das Docker-Image.

# PostgreSQL-Verbindung (docker compose up -d postgres)
DATABASE_URL=postgresql://dare:dare@localhost:5432/dare
GITLAB_API_URL=GitLab-Instanz-Einfügen
GITLAB_ACCESS_TOKEN=Access-Token-Einfügen
GITLAB_PROJECT_PATH=owner/repo
GITLAB_WEBHOOK_SECRET=

# Active platform adapter: 'gitlab' (default) or 'github'.
# Only one is wired at a time — see webhook.module.ts.
PM_PLATFORM=gitlab

# GitHub alternative to the GitLab adapter (see GitHubModule)
# For GitHub Enterprise use https://<host>/api/v3
GITHUB_API_URL=https://api.github.com
# Fine-grained Token: Organization permissions -> "Issue fields" (Read and write,
# Resource owner = die Organisation) plus Repository permissions -> "Issues"
# (Read and write). Das Feld anlegen darf nur ein Org-Admin. Classic PAT:
# admin:org + repo. Persönliche Konten haben keine Issue Fields.
GITHUB_ACCESS_TOKEN=Access-Token-Einfügen
# Beobachtetes Repository als owner/repo — Pflicht, solange keine Installation
# per Webhook in der DB liegt (siehe DeckWorkItemSyncService.resolveInstallation)
GITHUB_PROJECT_PATH=owner/repo
GITHUB_ISSUE_FIELD_NAME=Principles
GITHUB_WEBHOOK_SECRET=

# smee.io proxy for local webhook development (https://smee.io)
SMEE_URL=https://smee.io/dare-2026-27
