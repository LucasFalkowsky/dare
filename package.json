{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "prisma": {
    "seed": "ts-node src/seed.ts"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "tsc --noEmit -p src/frontend/tsconfig.json && vite build src/frontend",
    "start": "node dist/index.js",
    "dev:frontend": "vite src/frontend",
    "test:frontend": "vitest run --config src/frontend/vite.config.ts",
    "test:frontend:watch": "vitest --config src/frontend/vite.config.ts",
    "pretest:backend": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:backend": "DATABASE_URL=postgresql://dare:dare@localhost:5433/dare_test npx prisma migrate deploy && DATABASE_URL=postgresql://dare:dare@localhost:5433/dare_test jest --runInBand; EXIT=$?; docker compose -f docker-compose.test.yml down; exit $EXIT",
    "test": "npm run test:frontend && npm run test:backend",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node -r ts-node/register -r reflect-metadata src/seed.ts",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:test:up": "docker compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "knip": "knip",
    "webhook:dev": "node -e \"require('dotenv').config(); const {execSync} = require('child_process'); const platform = process.env.PM_PLATFORM === 'github' ? 'github' : 'gitlab'; execSync('npx smee-client --url ' + process.env.SMEE_URL + ' --target http://localhost:3000/webhooks/' + platform, {stdio:'inherit'})\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@trpc/server": "^11.17.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^26.3.6",
    "motion": "^12.40.0",
    "pg": "^8.21.0",
    "prisma": "^7.9.0",
    "react-i18next": "^17.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.22",
    "@nestjs/testing": "^11.1.26",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.5.3",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lucide-react": "^1.17.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.61.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.10.0",
    "smee-client": "^5.0.0",
    "storybook": "^10.5.3",
    "supertest": "^7.2.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
