{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "entry": [
    "src/index.ts",
    "src/seed.ts",
    "src/frontend/main.tsx"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "@prisma/client",
    "express",
    "pg",
    "@types/express",
    "@types/pg",
    "tailwindcss",
    "tw-animate-css",
    "@nestjs/cli",
    "nodemon",
    "shadcn",
    "@chromatic-com/storybook",
    "@storybook/addon-a11y",
    "@storybook/addon-docs",
    "@storybook/addon-mcp",
    "@eslint/js",
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "globals",
    "typescript-eslint"
  ],
  "vite": {
    "config": ["src/frontend/vite.config.ts"]
  }
}
